// Dead-code check (`npm run check:knip`, CI `check` job): unused files, exports, types and
// dependencies, plus unlisted / unresolved ones. Vite, Vitest, Playwright and ESLint are detected from
// their configs, so only what no config points at is listed here.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    // Each directory's barrel is its public surface (AGENTS.md: import through the barrel), so what a
    // barrel re-exports is not 'unused' just because nothing imports it through the barrel yet.
    "src/*/index.ts",
    // The Web Worker and the audio worklet are loaded by URL / file, not imported.
    "src/wasm/physics-worker.ts",
    "src/audio/pachinko-voice-processor.ts",
    // The headless replay runner: `vite build` emits it as dist/sim/node-replay.mjs (scripts/lib/sim-bundle.mjs).
    "src/sim/node-replay.ts",
    // Type-only: wasm-types.ts vs the Embind declarations, checked by tsc.
    "src/wasm/wasm-types-conformance.ts",
    // Ambient declarations: the `Window` globals and the worklet's globals reference these modules' types.
    "src/audio/worklet-globals.d.ts",
    // Playwright specs `import('/src/…')` these inside the page, by string, which knip cannot follow.
    "src/game.ts",
    "src/arcade/arcade-api.ts",
    "src/replay/ghost-race.ts",
    // Everything `npm run` or CI invokes, and the dev helpers (hard-coded to localhost, run by hand).
    "scripts/*.{mjs,ts}",
    "scripts/dev/*.{js,mjs}",
    "services/replay-verifier/*.mjs",
    // vitest.config.ts aliases these by path string.
    "tests/mocks/*.ts"
  ],
  "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.{mjs,ts,js}", "services/**/*.mjs"],
  // Emscripten --emit-tsd output, regenerated by `npm run build:wasm`.
  "ignore": ["src/wasm/generated/**"],
  // `typescript7` (the native compiler) is run by path from scripts/typecheck.mjs, never imported.
  "ignoreDependencies": ["typescript7"],
  // Toolchain binaries that are not npm packages.
  "ignoreBinaries": ["cmake", "ctest", "ffmpeg"],
  "ignoreIssues": {
    // `export { MockQuaternion as Quaternion, … }`: one mock deliberately stands in for several Babylon names.
    "tests/mocks/babylon-core.ts": ["duplicates"]
  }
}
