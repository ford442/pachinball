# Replay verifier environment (#444 Slice C). Copy to /etc/pachinball/replay-verifier.env (mode 600).

# Required: a Supabase secret key (Project Settings → API Keys → Secret keys).
ARCADE_SECRET_KEY=

ARCADE_SUPABASE_URL=https://znsioiaydrtsziwavdat.supabase.co
VERIFIER_DIST=/srv/pachinball/dist
# Optional: one `npm run build` output per build id, so old runs replay on their own build.
#VERIFIER_BUILDS=/srv/pachinball-builds
VERIFIER_POLL_MS=30000
VERIFIER_BATCH=4
