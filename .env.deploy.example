# Copy to .env.deploy and fill in real values. Never commit .env.deploy.
#
# Required
DEPLOY_TOKEN=your_deploy_token_from_vps_env

# Optional overrides (defaults shown)
# DEPLOY_BASE_URL=https://storage.noahcohn.com
# DEPLOY_PROJECT_NAME=pachinball
# DEPLOY_BUILD_DIR=dist
# DEPLOY_TARGET_FOLDER=pachinball

# Staging (docs/STAGING.md): the staging workflow pins these; set them only for a manual staging deploy.
# DEPLOY_PROJECT_NAME=pachinball-staging
# DEPLOY_TARGET_FOLDER=pachinball-staging
