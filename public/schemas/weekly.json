{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pachinball weekly machine",
  "description": "A weekly machine descriptor (rules.cascade.weekly; docs/DAILY_CASCADE.md).",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "pinField": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 8,
          "maximum": 12
        },
        "cols": {
          "type": "integer",
          "minimum": 11,
          "maximum": 15
        },
        "dropout": {
          "type": "number"
        },
        "dropoutSeed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "keepOuts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "minX": {
                "type": "number"
              },
              "maxX": {
                "type": "number"
              },
              "minZ": {
                "type": "number"
              },
              "maxZ": {
                "type": "number"
              }
            },
            "required": [
              "minX",
              "maxX",
              "minZ",
              "maxZ"
            ],
            "additionalProperties": false
          },
          "maxItems": 3
        }
      },
      "required": [
        "rows",
        "cols",
        "dropout",
        "dropoutSeed",
        "keepOuts"
      ],
      "additionalProperties": false
    },
    "bumpers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dx": {
            "type": "number"
          },
          "dz": {
            "type": "number"
          }
        },
        "required": [
          "dx",
          "dz"
        ],
        "additionalProperties": false
      },
      "minItems": 12,
      "maxItems": 12
    },
    "feeders": {
      "type": "object",
      "properties": {
        "magSpin": {
          "type": "boolean"
        },
        "nanoLoom": {
          "type": "boolean"
        },
        "prismCore": {
          "type": "boolean"
        },
        "gaussCannon": {
          "type": "boolean"
        },
        "quantumTunnel": {
          "type": "boolean"
        }
      },
      "required": [
        "magSpin",
        "nanoLoom",
        "prismCore",
        "gaussCannon",
        "quantumTunnel"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "seed",
    "pinField",
    "bumpers",
    "feeders"
  ],
  "additionalProperties": false
}
