                "standard": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 100
                },
                "gold_plated": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 100
                },
                "solid_gold": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "required": [
                "standard",
                "gold_plated",
                "solid_gold"
              ],
              "additionalProperties": false
            }
