{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pachinball machine",
  "description": "A machine: cabinet, tracks, backbox, audio, rules, seed policy (public/machines/*.json, .machine.json exports; docs/MACHINES.md).",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "name": {
      "type": "string"
    },
    "cabinet": {
      "enum": [
        "classic",
        "neo",
        "vertical",
        "wide"
      ],
      "type": "string"
    },
    "tracks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TrackRef"
      }
    },
    "backbox": {
      "type": "object",
      "properties": {
        "idle": {
          "type": "object",
          "properties": {
            "video": {
              "type": "string",
              "pattern": "^(?:[a-z0-9][a-z0-9_-]*\\/){0,3}[a-z0-9][a-z0-9._-]*\\.(?:mp4|webm)$"
            },
            "poster": {
              "type": "string",
              "pattern": "^(?:[a-z0-9][a-z0-9_-]*\\/){0,3}[a-z0-9][a-z0-9._-]*\\.(?:png|webp|jpg)$"
            }
          },
          "required": [
            "video"
          ],
          "additionalProperties": false
        },
        "reach": {
          "type": "object",
          "properties": {
            "video": {
              "type": "string",
              "pattern": "^(?:[a-z0-9][a-z0-9_-]*\\/){0,3}[a-z0-9][a-z0-9._-]*\\.(?:mp4|webm)$"
            },
            "poster": {
              "type": "string",
              "pattern": "^(?:[a-z0-9][a-z0-9_-]*\\/){0,3}[a-z0-9][a-z0-9._-]*\\.(?:png|webp|jpg)$"
            }
          },
          "required": [
            "video"
          ],
          "additionalProperties": false
        },
        "fever": {
          "type": "object",
          "properties": {
            "video": {
              "type": "string",
              "pattern": "^(?:[a-z0-9][a-z0-9_-]*\\/){0,3}[a-z0-9][a-z0-9._-]*\\.(?:mp4|webm)$"
            },
            "poster": {
              "type": "string",
              "pattern": "^(?:[a-z0-9][a-z0-9_-]*\\/){0,3}[a-z0-9][a-z0-9._-]*\\.(?:png|webp|jpg)$"
            }
          },
          "required": [
            "video"
          ],
          "additionalProperties": false
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9a-f]{6}$"
        },
        "shaderParams": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,31}$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": -1000,
            "maximum": 1000
          },
          "maxProperties": 16
        }
      },
      "required": [
        "idle",
        "reach",
        "fever",
        "border",
        "shaderParams"
      ],
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "stems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "enum": [
                  "drums",
                  "bass",
                  "lead",
                  "fever"
                ],
