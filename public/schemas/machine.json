                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "gold_plated": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "solid_gold": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                }
              },
              "required": [
                "standard",
                "gold_plated",
                "solid_gold"
              ],
              "additionalProperties": false
            },
            "feverMultipliers": {
