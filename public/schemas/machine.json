                  "minimum": 0,
                  "maximum": 1
                },
                "gold_plated": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "solid_gold": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "standard",
                "gold_plated",
                "solid_gold"
              ],
              "additionalProperties": false
            },
            "points": {
