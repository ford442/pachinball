{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pachinball machine index",
  "description": "The shipped machines list (public/machines/index.json; docs/MACHINES.md).",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "machines": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "cabinet": {
            "enum": [
              "classic",
              "neo",
              "vertical",
              "wide"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "cabinet"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    }
  },
  "required": [
    "schemaVersion",
    "machines"
  ],
  "additionalProperties": false
}
