{
  "name": "pachinball",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run build:wasm && vite build",
    "build_colab": "tsc -b && npm run build:wasm_colab && vite build",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:wasm_colab": "bash scripts/build-wasm-colab.sh",
    "build:wasm:debug": "bash scripts/build-wasm.sh --debug",
    "build:wasm:assert": "bash scripts/build-wasm.sh --assert",
    "bench:wasm-flags": "bash scripts/build-wasm.sh --bench-matrix && node scripts/bench-wasm-flags.mjs",
    "compile-db": "cmake -S native -B native/build-native -DCMAKE_BUILD_TYPE=Debug -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DPACHINBALL_BUILD_TESTS=ON -DPACHINBALL_SANITIZE=OFF -DPACHINBALL_UNITY_BUILD=OFF",
    "test:native":"npm run compile-db && cmake --build native/build-native && ctest --test-dir native/build-native --output-on-failure --no-tests=error",
    "test:native:san": "cmake -S native -B native/build-san -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS= -DPACHINBALL_BUILD_TESTS=ON -DPACHINBALL_SANITIZE=ON && cmake --build native/build-san --parallel 4 && ASAN_OPTIONS=abort_on_error=1:detect_leaks=1:strict_string_checks=1 UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1 ctest --test-dir native/build-san --output-on-failure --no-tests=error",
    "check:compile-db": "node scripts/check-compile-db.mjs",
    "check:wasm-docs": "node scripts/check-wasm-docs.mjs",
    "test:wasm-parity": "node scripts/run-wasm-parity.mjs",
    "print:wasm-flags": "node scripts/print-wasm-flags.mjs",
    "lint": "eslint .",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "check:dist-wasm": "node scripts/check-dist-wasm.mjs",
    "check:index-strict": "node scripts/check-index-strict.mjs",
    "perf:baseline": "PERF_BASELINE=1 playwright test tests/perf-baseline.spec.ts --project=chromium",
    "perf:compare": "node scripts/perf-compare.mjs",
    "preview": "vite preview",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "models:cabinet-placeholders": "node scripts/generate-cabinet-placeholders.mjs",
    "models:insert-placeholders": "node scripts/generate-insert-placeholders.mjs",
    "tracks:validate": "vitest run tests/tracks-validate-cli.test.ts",
    "machine:validate": "vitest run tests/weekly-machine-validate-cli.test.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@babylonjs/core": "^9.30.0",
    "@babylonjs/loaders": "^9.30.0",
    "@dimforge/rapier3d-compat": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import-x": "4.16.1",
    "globals": "^16.5.0",
    "happy-dom": "^20.9.0",
    "puppeteer": "^25.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.5",
    "workbox-window": "^7.4.1"
  }
}
